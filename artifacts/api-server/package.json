{
  "name": "@usestormline/api",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "esbuild src/lib/geopolitical-matching.test.ts --bundle --platform=node --format=esm --outfile=/tmp/stormline-geopolitical-matching.test.mjs && node --test /tmp/stormline-geopolitical-matching.test.mjs && node --experimental-strip-types --test src/lib/verified-geography.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@usestormline/api-zod-internal": "workspace:*",
    "@usestormline/db-internal": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  },
  "description": "Stormline intelligence and canonical Stock Token API",
  "license": "Apache-2.0",
  "author": "Stormline Contributors <support@usestormline.com>",
  "homepage": "https://github.com/usestormline/stormline-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usestormline/stormline-api.git"
  },
  "bugs": {
    "url": "https://github.com/usestormline/stormline-api/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "config",
    "package.json"
  ]
}
